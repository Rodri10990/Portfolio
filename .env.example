# GitHub README modal — per project use `owner/repo`, `owner/repo@branch`, or a full github.com URL (query/hash ok).
README_REPO_MASSIVE_AI=

# Psychology platform ("premium content hub" card): same repo whether you paste URL or shorthand.
# README_REPO_PREMIUM_CONTENT_HUB=Rodri10990/Plataforma-de-Psicologia
# README_REPO_PREMIUM_CONTENT_HUB=https://github.com/Rodri10990/Plataforma-de-Psicologia?tab=readme-ov-file#readme

README_REPO_PREMIUM_CONTENT_HUB=
README_REPO_REVOLUT_NOTION=
README_REPO_SKILLS_BOX=

# Optional: force a branch for all repos that don’t use `owner/repo@branch`. If unset, the server
# asks the GitHub API for each repo’s default branch (so `master` vs `main` is handled).
# README_GITHUB_BRANCH=main

# Optional: classic PAT (`ghp_…`) or fine-grained (`github_pat_…`). Required for private repos
# and improves rate limits. Classic tokens use `token …` on the wire; fine-grained use `Bearer`.
# GITHUB_TOKEN=

# Optional: path inside repo (no leading slash), defaults to README.md.
# README_PATH_MASSIVE_AI=docs/readme.md
# README_PATH_PREMIUM_CONTENT_HUB=
# README_PATH_REVOLUT_NOTION=
# README_PATH_SKILLS_BOX=
